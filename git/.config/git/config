[user]
	name = Angel Aguilera
	email = angel.aguilera@gmail.com

[color]
	ui = auto

[push]
	default = simple

[credential]
	helper = cache --timeout=3600

[diff]
	tool = meld

[credential "https://github.com"]
	username = aaguilera

[alias]
	lod = log --oneline --decorate --color
	sdiff = !git diff && git submodule foreach 'git diff'
	spush = push --recurse-submodules=on-demand
	supdate = submodule update --remote --merge
	br = branch -avv
	superlog = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all

[status]
	submodulesummary = 1

[core]
	pager = less
	askPass = ksshaskpass

[pull]
	ff = only

[init]
	defaultBranch = main
